    "test_sets": {
        "python_prompted_detection_GPU": {
            "name": "python_prompted_detection_GPU",
            "dataset.groundtruth": "python_prompted_detection_GPU.json",
            "sample.command": "python3,{sample.dir}/python/prompted_detection/prompted_detection.py,--input,{dataset.video}/Pexels_Videos_1192116-sd_640_360_30fps.mp4,--prompt,white car,--device,GPU,--output,json"
        },
        "python_prompted_detection_NPU": {
            "name": "python_prompted_detection_NPU",
            "dataset.groundtruth": "python_prompted_detection_NPU.json",
            "sample.command": "python3,{sample.dir}/python/prompted_detection/prompted_detection.py,--input,{dataset.video}/Pexels_Videos_1192116-sd_640_360_30fps.mp4,--prompt,white car,--device,NPU,--output,json"
        },
        "python_vlm_alerts_GPU": {
            "name": "python_vlm_alerts_GPU",
            "dataset.comparator_type": "genai",
            "dataset.genai.confidence_thr": 0.1,
            "dataset.groundtruth": "python_vlm_alerts_GPU.json",
            "sample.command": "python3,{sample.dir}/python/vlm_alerts/vlm_alerts.py,--video-path,{dataset.video}/Pexels_Videos_2103099-hd_1280_720_60fps.mp4,--prompt,Is there a car in the image? Answer yes or no.,--device,GPU,--results-dir,{dataset.artifacts},--output-json,output.json"
        },
        "python_vlm_self_checkout_GPU": {
            "name": "python_vlm_self_checkout_GPU",
            "dataset.comparator_type": "genai",
            "dataset.genai.compare_text": false,
            "dataset.groundtruth": "python_vlm_self_checkout_GPU.json",
            "sample.command": "python3,{sample.dir}/python/vlm_self_checkout/vlm_self_checkout.py,--video-path,{dataset.video}/Pexels_Videos_14936073_1920_1080_30fps.mp4,--detect-device,GPU,--genai-device,GPU,--results-dir,{dataset.artifacts},--output-json,output.json"
        },
        "python_watermark_meta": {
            "name": "python_watermark_meta",
            "dataset.comparator_type": "watermark",
            "dataset.pixel_threshold": 2,
            "dataset.bad_pixel_fraction": 0.001,
            "pipeline.out_frames_dir": "python_watermark_meta",
            "dataset.groundtruth": "python_watermark_meta",
            "sample.command": "python3,{sample.dir}/python/watermark_meta/watermark_meta.py,videotestsrc,{dataset.artifacts}/python_watermark_meta"
        },
        "pallet_defect_detection_CPU": {
            "name": "pallet_defect_detection_CPU",
            "dataset.groundtruth": "pallet_defect_detection_CPU.json",
            "sample.command": "{sample.dir}/gst_launch/geti_deployment/geti_sample.sh,detection,public/pallet_defect_detection/INT8/pallet_defect_detection.xml,CPU,opencv,{dataset.video}/warehouse.avi,json"
        },
        "pallet_defect_detection_GPU": {
            "name": "pallet_defect_detection_GPU",
            "dataset.groundtruth": "pallet_defect_detection_GPU.json",
            "sample.command": "{sample.dir}/gst_launch/geti_deployment/geti_sample.sh,detection,public/pallet_defect_detection/INT8/pallet_defect_detection.xml,GPU,va-surface-sharing,{dataset.video}/warehouse.avi,json"
        },
        "pallet_defect_detection_NPU": {
            "name": "pallet_defect_detection_NPU",
            "dataset.groundtruth": "pallet_defect_detection_NPU.json",
            "sample.command": "{sample.dir}/gst_launch/geti_deployment/geti_sample.sh,detection,public/pallet_defect_detection/INT8/pallet_defect_detection.xml,NPU,va,{dataset.video}/warehouse.avi,json"
        }
    }
