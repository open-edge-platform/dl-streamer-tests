FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl=8.5.0-2ubuntu10.8 \
    ca-certificates=20240203 \
    tar=1.35+dfsg-3build1 \
    gzip=1.12-1ubuntu3.1 \
    jq=1.7.1-3ubuntu0.24.04.1 \
    libtbb12=2021.11.0-2ubuntu2 \
    gpg=2.4.4-2ubuntu17.4 \
    git=1:2.43.0-1ubuntu7.3 \
    git-lfs=3.4.1-1ubuntu0.3 \
    sudo=1.9.15p5-3ubuntu5.24.04.2 \
    iproute2=6.1.0-1ubuntu6.2 \
    python3=3.12.3-0ubuntu2.1 \
    python3-pip=24.0+dfsg-1ubuntu1.3 \
    python3-venv=3.12.3-0ubuntu2.1 \
    libicu74=74.2-1ubuntu3.1 \
    gnupg=2.4.4-2ubuntu17.4 \
    lsb-release=12.0-2 \
    rsync=3.2.7-1ubuntu1.2 \
    openssh-client=1:9.6p1-3ubuntu13.15 \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI
ARG DOCKER_VERSION=29.3.0
RUN curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
 && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" \
    > /etc/apt/sources.list.d/docker.list
RUN apt-get update && apt-get install -y \
    docker-ce-cli=5:${DOCKER_VERSION}-1~ubuntu.24.04~noble \
    docker-buildx-plugin \
    docker-compose-plugin \
 && rm -rf /var/lib/apt/lists/*

# Create a non-root user and add to sudoers and docker group
RUN useradd -m -s /bin/bash runner \
 && echo "runner ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Add runner user to docker group for Docker access
RUN groupadd -f docker \
 && usermod -aG docker runner

# Add render and video groups for GPU and NPU access
RUN groupadd -f -g 992 render && usermod -aG render runner
RUN groupadd -f -g 44 video && usermod -aG video runner

WORKDIR /home/runner

# Download and set up GitHub Actions runner
ARG RUNNER_VERSION=2.333.1
RUN curl -L -o actions-runner.tar.gz \
    https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz \
 && tar xzf actions-runner.tar.gz \
 && rm actions-runner.tar.gz

RUN ./bin/installdependencies.sh
RUN chown -R runner:runner /home/runner

USER runner
ENV USER=runner
ENTRYPOINT ["./run.sh"]
